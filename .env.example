# Illustration only. python scripts/dev.py up creates random local credentials.
# Never copy example values into production.
POSTGRES_PASSWORD=generate-with-dev-script
CSRF_SECRET=generate-with-dev-script
DATABASE_URL=postgresql+psycopg://wqs:replace-me@localhost:5432/wenyushu
ALLOWED_ORIGINS=["http://localhost:3000"]
ENVIRONMENT=development
PROVIDER=mock
ACTOR_TTL_SECONDS=604800
CSRF_TTL_SECONDS=3600
MAX_BODY_BYTES=65536
# Server only. Use PROVIDER=deepseek for real discussion; never use NEXT_PUBLIC_ for secrets.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
CHAT_TIMEOUT_SECONDS=60
CHAT_CONTEXT_BUDGET=32000
CHAT_MAX_OUTPUT_TOKENS=1024
CHAT_DAILY_TURN_LIMIT=100
CHAT_GLOBAL_TURN_LIMIT=1000
